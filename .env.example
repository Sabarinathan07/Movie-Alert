# Movie-Alert environment variables
# Copy to .env and fill in:  cp .env.example .env
# Never commit .env. On GitHub Actions, add the same names as repo secrets
# (Settings → Secrets and variables → Actions).

# --- Fetching -----------------------------------------------------------------
# BookMyShow blocks non-India / datacenter IPs. Needed on GitHub runners, not on
# an India VPS or home connection. District is tried directly first.
SCRAPERAPI_KEY=                      # scraperapi.com dashboard → API key (32 chars)
PROXY_URL=                           # optional alternative: http://user:pass@in-proxy-host:port

# --- Telegram messages (free) -------------------------------------------------
TELEGRAM_BOT_TOKEN=                  # @BotFather → /newbot → 123456789:AA...
TELEGRAM_CHAT_ID=                    # your chat id (send /start to the bot, then getUpdates)

# --- Telegram voice call via CallMeBot (free, best effort) --------------------
# Authorise once: send /start to @CallMeBot_txtbot; Telegram Privacy → Calls → Everybody
CALLMEBOT_TG_USER=                   # @your_telegram_username

# --- Phone call via Twilio (primary, paid) ------------------------------------
TWILIO_ACCOUNT_SID=                  # ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=                   # 32 hex chars (Console → Account → API keys & tokens)
TWILIO_FROM=                         # your Twilio number, E.164 e.g. +18455550123
CALL_TO=                             # number to ring, E.164 e.g. +919800000000
                                     # (trial accounts can only call verified numbers)

# --- Extra users referenced from watches.json as "env:NAME" -------------------
# Any name works; these match watches.example.json.
FRIEND1_TELEGRAM_CHAT_ID=
FRIEND1_PHONE=

# --- Optional paths -------------------------------------------------------------
# WATCH_CONFIG=watches.json
# WATCH_STATE=watch_state.json
